<?xml version="1.0"?>
<Devices>
    <Device type="custom" id="inverter">
        <Name>AlphaESS Inverter</Name>
        <ConfigUI>
            <Field id="address" type="textfield">
                <Label>Inverter IP Address:</Label>
                <Description>Local IP of the inverter's LAN port (Modbus TCP is not available over Wi-Fi)</Description>
            </Field>
            <Field id="port" type="textfield" defaultValue="502">
                <Label>Modbus TCP Port:</Label>
            </Field>
            <!-- AlphaESS inverters only ever answer on unit/slave ID 0x55 (85) -
                 it's not configurable on the inverter itself, but exposing it
                 avoids hardcoding a magic number future models might change. -->
            <Field id="unitId" type="textfield" defaultValue="85">
                <Label>Modbus Unit/Slave ID:</Label>
                <Description>AlphaESS inverters use 85 (0x55) - only change this if yours differs</Description>
            </Field>
            <Field id="pollInterval" type="menu" defaultValue="30">
                <Label>Poll Interval:</Label>
                <Description>AlphaESS's own Modbus spec recommends polling no faster than every 5 seconds - going faster risks overloading the inverter's Modbus interface. 30 seconds is a good default for home monitoring.</Description>
                <List>
                    <Option value="5">5 seconds (not recommended - below AlphaESS's own minimum)</Option>
                    <Option value="10">10 seconds</Option>
                    <Option value="15">15 seconds</Option>
                    <Option value="30">30 seconds (default)</Option>
                    <Option value="60">1 minute</Option>
                    <Option value="300">5 minutes</Option>
                </List>
            </Field>
            <Field id="dispatchSeparator" type="separator"/>
            <Field id="dispatchDefaultsLabel" type="label" alignText="left">
                <Label>The Force Charging/Discharging actions below use these defaults for any field left blank on the action itself.</Label>
            </Field>
            <!-- Caps Force Charging/Discharging/Dispatch power requests to what this
                 inverter model can actually do - same option list and purpose as the
                 "Inverter AC Limit" selector in both senalse/ha-alphaess-modbus and
                 Hillview Lodge's reference implementations. Defaults to 20 (their own
                 unconfigured fallback) - set this to your inverter's actual nameplate
                 AC rating for the cap to be meaningful. -->
            <Field id="acLimitKw" type="menu" defaultValue="20">
                <Label>Inverter AC Power Limit:</Label>
                <Description>Your inverter's rated AC output - caps how much power Force Charging/Discharging and Dispatch can request. Check your inverter's nameplate/datasheet if unsure.</Description>
                <List>
                    <Option value="3">3 kW</Option>
                    <Option value="4">4 kW</Option>
                    <Option value="4.6">4.6 kW</Option>
                    <Option value="5">5 kW</Option>
                    <Option value="6">6 kW</Option>
                    <Option value="8">8 kW</Option>
                    <Option value="10">10 kW</Option>
                    <Option value="12">12 kW</Option>
                    <Option value="15">15 kW</Option>
                    <Option value="20">20 kW (default)</Option>
                </List>
            </Field>
            <Field id="forceChargingPower" type="textfield" defaultValue="5.0">
                <Label>Force Charging Power (kW):</Label>
                <Description>Valid range: 0 kW up to the Inverter AC Power Limit above (max 20 kW)</Description>
            </Field>
            <Field id="forceChargingCutoffSoC" type="textfield" defaultValue="100">
                <Label>Force Charging Cutoff SoC (%):</Label>
                <Description>Charging stops once the battery reaches this level. Valid range: 4-100%</Description>
            </Field>
            <Field id="forceChargingDuration" type="textfield" defaultValue="120">
                <Label>Force Charging Duration (min):</Label>
                <Description>Valid range: 0-480 min (8 hours)</Description>
            </Field>
            <Field id="forceDischargingPower" type="textfield" defaultValue="5.0">
                <Label>Force Discharging Power (kW):</Label>
                <Description>Valid range: 0 kW up to the Inverter AC Power Limit above (max 20 kW)</Description>
            </Field>
            <Field id="forceDischargingCutoffSoC" type="textfield" defaultValue="20">
                <Label>Force Discharging Cutoff SoC (%):</Label>
                <Description>Discharging stops once the battery reaches this level (a reserve floor). Valid range: 4-100%</Description>
            </Field>
            <Field id="forceDischargingDuration" type="textfield" defaultValue="120">
                <Label>Force Discharging Duration (min):</Label>
                <Description>Valid range: 0-480 min (8 hours)</Description>
            </Field>
            <Field id="forceImportPower" type="textfield" defaultValue="5.0">
                <Label>Force Import Power (kW):</Label>
                <Description>Target grid import level - the inverter charges the battery with however much of this (plus any spare solar) it takes to hold grid import at this rate. Valid range: 0 kW up to the Inverter AC Power Limit above (max 20 kW)</Description>
            </Field>
            <Field id="forceImportCutoffSoC" type="textfield" defaultValue="90">
                <Label>Force Import Cutoff SoC (%):</Label>
                <Description>Import stops once the battery reaches this level. Valid range: 4-100%</Description>
            </Field>
            <Field id="forceImportDuration" type="textfield" defaultValue="120">
                <Label>Force Import Duration (min):</Label>
                <Description>Valid range: 0-480 min (8 hours)</Description>
            </Field>
        </ConfigUI>
        <States>
            <State id="loadPower">
                <ValueType>Integer</ValueType>
                <TriggerLabel>House Load Power Changed</TriggerLabel>
                <ControlPageLabel>House Load</ControlPageLabel>
                <Units>W</Units>
            </State>
            <State id="invTemperature">
                <ValueType>Number</ValueType>
                <TriggerLabel>Inverter Temperature Changed</TriggerLabel>
                <ControlPageLabel>Inverter Temperature</ControlPageLabel>
                <Units>°C</Units>
            </State>
            <State id="invWorkMode">
                <ValueType>String</ValueType>
                <TriggerLabel>Inverter Work Mode Changed</TriggerLabel>
                <ControlPageLabel>Work Mode</ControlPageLabel>
            </State>
            <State id="systemTime">
                <ValueType>String</ValueType>
                <TriggerLabel>Inverter System Time Changed</TriggerLabel>
                <ControlPageLabel>System Time</ControlPageLabel>
            </State>
            <State id="dispatchActive">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Dispatch Active Changed</TriggerLabel>
                <ControlPageLabel>Dispatch Active</ControlPageLabel>
            </State>
            <State id="dispatchType">
                <ValueType>String</ValueType>
                <TriggerLabel>Dispatch Type Changed</TriggerLabel>
                <ControlPageLabel>Dispatch Type</ControlPageLabel>
            </State>
            <State id="dispatchModeLabel">
                <ValueType>String</ValueType>
                <TriggerLabel>Dispatch Mode Changed</TriggerLabel>
                <ControlPageLabel>Dispatch Mode</ControlPageLabel>
            </State>
            <State id="dispatchPowerTarget">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Dispatch Power Target Changed</TriggerLabel>
                <ControlPageLabel>Dispatch Power Target</ControlPageLabel>
                <Units>W</Units>
            </State>
            <State id="dispatchEndsAt">
                <ValueType>String</ValueType>
                <TriggerLabel>Dispatch Ends At Changed</TriggerLabel>
                <ControlPageLabel>Dispatch Ends At</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>loadPower</UiDisplayStateId>
    </Device>

